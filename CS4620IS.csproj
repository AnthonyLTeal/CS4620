<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <LangVersion>12</LangVersion>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />
        <Compile Remove="Systems\DrawSystem.cs" />
        <None Include="Systems\DrawSystem.txt" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico" />
        <EmbeddedResource Include="Icon.bmp" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.4" />
        <PackageReference Include="MonoGame.Framework.Compute.DesktopGL" Version="3.8.3" />
        <PackageReference Include="Nopipeline.Task" Version="2.2.0" />
        <PackageReference Include="ScottPlot" Version="5.1.58" />
        <PackageReference Include="Gum.MonoGame" Version="2025.12.9.1" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Content\Models\" />
      <Folder Include="Content\Shaders\" />
      <Folder Include="Content\Textures\" />
      <Folder Include="Graphs\" />
    </ItemGroup>
    <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
        <Message Text="Restoring dotnet tools" Importance="High" />
        <Exec Command="dotnet tool restore" />
    </Target>
</Project>