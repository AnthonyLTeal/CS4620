             //         Console.WriteLine("Null Destination");
             //         car.DestinationPointer.Current = -1;
             //     }
             // }
             
             if (car.DestinationPointer.Count != 0 && !PathExists(destinationBlob.GetDestination(car.DestinationPointer), car.ConnectedSegmentId))
             {
