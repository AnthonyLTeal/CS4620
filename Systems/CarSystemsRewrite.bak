                 car.DestinationPointer.Count = 0;
             }
             
             if (car.DestinationPointer.Count == 0)
             {
                 Console.WriteLine("No Destinations :(");
                 entitiesToRemove.Add(entity);
                 // foreach (string comment in car.Log)
                 // {
                 //     Console.WriteLine(comment);
                 // }
                 //Console.WriteLine();
                 continue;
             }

             ValidateDestinationSegment(destinationBlob.GetDestination(car.DestinationPointer), car);
             ValidateCurrentSegment(ref car, destinationBlob.GetDestination(car.DestinationPointer));
             
             // try
             // {
                MoveCar(ref car, entity, virtualDt, destinationBlob.GetDestination(car.DestinationPointer), destinationBlob);
             // }
             // catch (Exception e)
             // {
             //     //TODO there are still times where we are getting index errors in getnextvertex so killing those entities for now when it happens
             //     Console.WriteLine(e);
             //     entitiesToRemove.Add(entity);
             // }
             
         }

         foreach (int entity in entitiesToRemove)
         {
             //Console.WriteLine("Killing Entity: " + entity);
             Car car = ComponentManager.GetComponent<Car>(entity);
             // Check if the car is currently waiting at a connector
             // if (car.OnConnector != -1)
             // {
             //     RoadMesh roadMesh = ComponentManager.GetGlobalComponent<RoadMesh>();
             //     PathSegmentConnector connector = roadMesh.PathSegmentConnectors[car.OnConnector];
             //     
             //     connector.StopQueue.Remove(entity);
             // }
             //
             Console.WriteLine("Removing entity for some unknown reason");
             car.ConnectedSegment.EntitiesOnSegment.Remove(entity);
             ComponentManager.DestroyEntity(entity);
         }
